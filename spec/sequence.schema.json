{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blendy.local/spec/sequence.schema.json",
  "title": "Blendy Breakdown",
  "description": "The shot list. Proposed by the breakdown agent from the script, read and approved by a human before anything downstream runs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "bible", "shots"],
  "properties": {
    "version": {"const": "1.0"},
    "bible": {"type": "string", "description": "Path to the bible this breakdown was made against."},
    "approved": {
      "type": "boolean",
      "description": "Set by a human. Downstream stages refuse an unapproved breakdown."
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "scene_id",
          "script_ref",
          "location",
          "look",
          "cast",
          "beat",
          "shot_type",
          "duration_frames",
          "dialogue",
          "enters_with",
          "exits_with"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^s[0-9]{2}_[0-9]{3}$"},
          "scene_id": {"type": "string", "pattern": "^s[0-9]{2}$"},
          "script_ref": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "minItems": 1,
            "description": "Line or beat ids from the parsed script."
          },
          "location": {"$ref": "#/$defs/id"},
          "look": {"$ref": "#/$defs/id"},
          "cast": {"type": "array", "items": {"$ref": "#/$defs/id"}},
          "beat": {"type": "string", "minLength": 1, "description": "One line of intent, plain language."},
          "shot_type": {
            "enum": [
              "establishing",
              "wide",
              "medium",
              "medium_close",
              "close",
              "extreme_close",
              "insert",
              "over_shoulder",
              "two_shot",
              "pov"
            ]
          },
          "duration_frames": {"type": "integer", "exclusiveMinimum": 0},
          "dialogue": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "render_engine": {
            "enum": ["BLENDER_EEVEE", "CYCLES"],
            "description": "Per-shot override, decided before lighting."
          },
          "enters_with": {"$ref": "#/$defs/continuity_state"},
          "exits_with": {"$ref": "#/$defs/continuity_state"},
          "cut_before": {
            "type": "boolean",
            "description": "True if a scene cut precedes this shot; the continuity chain resets."
          }
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 64},
    "continuity_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["positions", "props", "world"],
      "properties": {
        "positions": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
        "props": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "held_by": {"type": "string"},
              "hand": {"enum": ["L", "R"]},
              "placed_at": {"type": "string"}
            }
          }
        },
        "world": {"type": "object", "additionalProperties": {"type": ["boolean", "string", "number"]}},
        "emotional": {"type": ["string", "null"]}
      }
    }
  }
}
