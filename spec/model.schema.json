{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blendy.local/spec/model.schema.json",
  "title": "Blendy Model Recipe",
  "description": "A character, prop or set built from declarative parts. The modeling agent edits this and looks at the turntable; the compiler owns every builder.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "kind",
    "parts",
    "materials",
    "landmarks",
    "skeleton"
  ],
  "properties": {
    "version": {
      "const": "1.0"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "kind": {
      "enum": [
        "character",
        "prop",
        "set"
      ]
    },
    "description": {
      "type": "string"
    },
    "reference": {
      "type": [
        "string",
        "null"
      ],
      "description": "Reference image path, shown beside the turntable."
    },
    "reference_points": {
      "type": [
        "object",
        "null"
      ],
      "description": "Landmarks marked on the reference image, in normalized coordinates ([0,1], origin top-left, y down). Compared against the built model's own landmarks as scale-invariant proportions. Mark the shoulder where the arm meets the torso, not the outer silhouette edge, because the model's shoulder landmark is the joint.",
      "propertyNames": {
        "enum": [
          "head_top",
          "chin",
          "eye",
          "shoulder_l",
          "shoulder_r",
          "ground",
          "hip",
          "ear_l",
          "ear_r",
          "hand_l",
          "hand_r",
          "knee"
        ]
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minItems": 2,
        "maxItems": 2
      }
    },
    "reference_size": {
      "type": [
        "array",
        "null"
      ],
      "description": "Reference image pixel size [width, height]. Needed because normalized coordinates divide x by width and y by height, so a width and a height are only comparable once the aspect ratio is divided back out.",
      "items": {
        "type": "integer",
        "exclusiveMinimum": 0
      },
      "minItems": 2,
      "maxItems": 2
    },
    "height": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0,
      "description": "Intended height in meters. The profile records the measured height; the validator flags drift."
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/part"
      }
    },
    "materials": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/material"
      }
    },
    "landmarks": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/landmark"
      }
    },
    "skeleton": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/skeleton"
        }
      ]
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "maxLength": 64
    },
    "vec3": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "vec2": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "rgb": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0
      },
      "minItems": 3,
      "maxItems": 3
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "location",
        "rotation_euler",
        "scale"
      ],
      "properties": {
        "location": {
          "$ref": "#/$defs/vec3"
        },
        "rotation_euler": {
          "$ref": "#/$defs/vec3"
        },
        "scale": {
          "$ref": "#/$defs/vec3"
        }
      },
      "description": "Relative to the parent part, meters and radians."
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "op",
        "params",
        "transform",
        "parent",
        "material",
        "modifiers"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "op": {
          "enum": [
            "primitive",
            "skin",
            "loft",
            "head",
            "hand",
            "sheet",
            "hair",
            "revolve",
            "extrude",
            "tube",
            "metaball"
          ]
        },
        "params": {
          "type": "object"
        },
        "transform": {
          "$ref": "#/$defs/transform"
        },
        "parent": {
          "oneOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "material": {
          "oneOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "modifiers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/modifier"
          }
        },
        "smooth": {
          "type": "boolean",
          "description": "Smooth shading (default true for organic ops)."
        },
        "mirror_of": {
          "oneOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ],
          "description": "Build as the X-mirror of another part instead of from params."
        },
        "at": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "part",
                "point"
              ],
              "properties": {
                "part": {
                  "$ref": "#/$defs/id"
                },
                "point": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "offset": {
                  "$ref": "#/$defs/vec3"
                }
              }
            }
          ],
          "description": "Place this part at another part's published point (head/hand/loft), instead of by transform.location. Eyes in sockets, rings on fingers, helmets on skulls."
        }
      }
    },
    "primitive_params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shape",
        "size"
      ],
      "properties": {
        "shape": {
          "enum": [
            "cube",
            "sphere",
            "cylinder",
            "cone",
            "torus",
            "plane"
          ]
        },
        "size": {
          "$ref": "#/$defs/vec3",
          "description": "Full dimensions in meters (torus: [major diameter, major diameter, minor diameter])."
        },
        "segments": {
          "type": "integer",
          "minimum": 3,
          "maximum": 128
        }
      }
    },
    "skin_params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "joints",
        "edges"
      ],
      "properties": {
        "joints": {
          "type": "object",
          "minProperties": 2,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "position",
              "radius"
            ],
            "properties": {
              "position": {
                "$ref": "#/$defs/vec3"
              },
              "radius": {
                "oneOf": [
                  {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  {
                    "$ref": "#/$defs/vec2"
                  }
                ],
                "description": "Meters; [rx, ry] for an oval cross-section."
              },
              "loose": {
                "type": "boolean",
                "description": "Sharp end cap instead of a rounded one."
              }
            }
          }
        },
        "edges": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "root": {
          "type": "string"
        },
        "subdivision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "smooth_shading": {
          "type": "boolean"
        }
      }
    },
    "revolve_params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile"
      ],
      "properties": {
        "profile": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/vec2"
          },
          "description": "[radius, z] pairs from bottom to top."
        },
        "segments": {
          "type": "integer",
          "minimum": 3,
          "maximum": 128
        },
        "cap": {
          "type": "boolean"
        }
      }
    },
    "extrude_params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outline",
        "depth"
      ],
      "properties": {
        "outline": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/vec2"
          },
          "description": "XY polygon, counter-clockwise."
        },
        "depth": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "taper": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Scale of the top face relative to the bottom."
        }
      }
    },
    "tube_params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "points",
        "radius"
      ],
      "properties": {
        "points": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/vec3"
          }
        },
        "radius": {
          "oneOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "array",
              "items": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          ]
        },
        "segments": {
          "type": "integer",
          "minimum": 3,
          "maximum": 64
        },
        "bezier": {
          "type": "boolean",
          "description": "Smooth curve through the points instead of a polyline."
        },
        "resolution": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "caps": {
          "type": "boolean"
        }
      }
    },
    "metaball_params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blobs"
      ],
      "properties": {
        "blobs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "position",
              "radius"
            ],
            "properties": {
              "position": {
                "$ref": "#/$defs/vec3"
              },
              "radius": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "shape": {
                "enum": [
                  "ball",
                  "ellipsoid",
                  "capsule"
                ]
              },
              "size": {
                "$ref": "#/$defs/vec3"
              },
              "negative": {
                "type": "boolean"
              }
            }
          }
        },
        "resolution": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "threshold": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "hair_params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "emitter",
        "count",
        "length"
      ],
      "description": "Tapered strands grown off an emitter part's surface. The part must be parented to its emitter. Deterministic per seed.",
      "properties": {
        "emitter": {
          "$ref": "#/$defs/id"
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4000
        },
        "length": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "segments": {
          "type": "integer",
          "minimum": 2,
          "maximum": 24
        },
        "sides": {
          "type": "integer",
          "minimum": 3,
          "maximum": 12
        },
        "clump": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "gravity": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "curl": {
          "type": "number",
          "minimum": 0,
          "maximum": 4
        },
        "sway": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "taper": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "direction": {
          "$ref": "#/$defs/vec3"
        },
        "region": {
          "$ref": "#/$defs/region"
        },
        "seed": {
          "type": "integer"
        },
        "avoid": {
          "type": "array",
          "description": "Keep-out spheres in the emitter's local space. Strands are pushed out of them, so hair cannot fall across the face.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "center",
              "radius"
            ],
            "properties": {
              "center": {
                "$ref": "#/$defs/vec3"
              },
              "radius": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        },
        "length_var": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.9,
          "description": "How much strand lengths differ, as a fraction. Uniform length gives the mass a machine-cut hem, which is the loudest tell that hair is not hair."
        },
        "jitter": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.6,
          "description": "Random turn applied per strand at the root, so neighbours do not run parallel and read as ribbon."
        },
        "lay": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "How far the root direction lies along the surface rather than straight out of it. Hair leaves a follicle nearly flat to the skin; 0 makes a scalp into a hedgehog."
        }
      }
    },
    "modifier": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "subdivision",
            "bevel",
            "mirror",
            "solidify",
            "boolean",
            "displace",
            "array",
            "shrinkwrap",
            "smooth",
            "cloth",
            "decimate",
            "push"
          ]
        },
        "levels": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "width": {
          "type": "number",
          "minimum": 0
        },
        "segments": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "angle": {
          "type": "number"
        },
        "axis": {
          "enum": [
            "x",
            "y",
            "z"
          ]
        },
        "merge": {
          "type": "boolean"
        },
        "thickness": {
          "type": "number"
        },
        "offset": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "$ref": "#/$defs/vec3"
            }
          ]
        },
        "operation": {
          "enum": [
            "union",
            "difference",
            "intersect"
          ]
        },
        "part": {
          "$ref": "#/$defs/id"
        },
        "strength": {
          "type": "number"
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "detail": {
          "type": "number",
          "minimum": 0,
          "maximum": 16
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "factor": {
          "type": "number"
        },
        "iterations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "pin": {
          "enum": [
            "top",
            "bottom",
            "left",
            "right",
            "front",
            "back"
          ]
        },
        "frame": {
          "type": "integer",
          "minimum": 1
        },
        "stiffness": {
          "type": "number",
          "minimum": 0
        },
        "ratio": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "center": {
          "$ref": "#/$defs/vec3"
        },
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "direction": {
          "$ref": "#/$defs/vec3"
        },
        "falloff": {
          "enum": [
            "smooth",
            "linear"
          ]
        },
        "collide": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "description": "cloth: parts the sheet falls onto."
        },
        "pin_region": {
          "$ref": "#/$defs/region",
          "description": "cloth: which vertices are held."
        },
        "clearance": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "quality": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "mass": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "bending": {
          "type": "number",
          "minimum": 0
        },
        "self_collision": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "base_color": {
          "$ref": "#/$defs/rgb"
        },
        "roughness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "metallic": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "specular": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "subsurface": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "subsurface_color": {
          "$ref": "#/$defs/rgb"
        },
        "sheen": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "emission": {
          "$ref": "#/$defs/rgb"
        },
        "emission_strength": {
          "type": "number",
          "minimum": 0
        },
        "noise": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scale",
            "strength"
          ],
          "properties": {
            "scale": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "strength": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "color": {
              "$ref": "#/$defs/rgb"
            },
            "detail": {
              "type": "number",
              "minimum": 0,
              "maximum": 16
            }
          },
          "description": "Second color blended in by a noise field."
        },
        "grunge": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "strength"
          ],
          "properties": {
            "strength": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "scale": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "description": "Darkens and roughens in noise pockets: dirt, wear."
        },
        "scratches": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "strength"
          ],
          "properties": {
            "strength": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "scale": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "bump": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "strength"
          ],
          "properties": {
            "strength": {
              "type": "number",
              "minimum": 0,
              "maximum": 2
            },
            "scale": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "detail": {
              "type": "number",
              "minimum": 0,
              "maximum": 16
            }
          }
        }
      }
    },
    "landmark": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "part",
            "anchor"
          ],
          "properties": {
            "part": {
              "$ref": "#/$defs/id"
            },
            "anchor": {
              "type": "string",
              "pattern": "^(center|origin|top|bottom|front|back|left|right|joint:[a-z][a-z0-9_]*|point:[a-z][a-z0-9_]*)$",
              "description": "Bounding-box anchor, `joint:<name>` on a skin graph, or `point:<name>` published by head/hand/loft."
            },
            "offset": {
              "$ref": "#/$defs/vec3"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "position"
          ],
          "properties": {
            "position": {
              "$ref": "#/$defs/vec3"
            },
            "normal": {
              "$ref": "#/$defs/vec3"
            }
          }
        }
      ]
    },
    "skeleton": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "rigify_human"
        },
        "bones": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/vec3"
          },
          "description": "Metarig bone head positions by landmark name or explicit vec3. Filled in at the rigging milestone."
        }
      }
    },
    "station": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "size"
      ],
      "properties": {
        "position": {
          "$ref": "#/$defs/vec3"
        },
        "size": {
          "$ref": "#/$defs/vec2",
          "description": "[half-width, half-depth] of the cross-section, meters."
        },
        "roundness": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 3.0,
          "description": "1.0 ellipse, 0.5 diamond, 1.5+ rounded rectangle."
        },
        "twist": {
          "type": "number",
          "description": "Radians, about the path."
        }
      }
    },
    "shape_op": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "center",
        "radius",
        "strength"
      ],
      "properties": {
        "center": {
          "$ref": "#/$defs/vec3"
        },
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "direction": {
          "$ref": "#/$defs/vec3"
        },
        "strength": {
          "type": "number"
        },
        "axis": {
          "enum": [
            "x",
            "y",
            "z"
          ]
        }
      },
      "description": "Smooth local displacement. With direction it pushes that way; without, radially off the axis."
    },
    "loft_params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/station"
          }
        },
        "segments": {
          "type": "integer",
          "minimum": 4,
          "maximum": 128
        },
        "resolution": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12,
          "description": "Interpolated rings between stations; 3 is smooth."
        },
        "caps": {
          "type": "boolean"
        },
        "shape": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/shape_op"
          }
        },
        "points": {
          "type": "object",
          "description": "Extra named points published for `point:` landmark anchors, as name -> index into this part's own path. A limb's start is its inner root, which for an arm is inside the torso; naming the station at the joint lets a landmark sit where the joint actually is.",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "head_params": {
      "type": "object",
      "additionalProperties": false,
      "description": "Parametric skull. Origin is the chin bottom on the neck axis; the face looks -Y.",
      "properties": {
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Chin to crown, meters (adult ~0.235)."
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "depth": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "segments": {
          "type": "integer",
          "minimum": 12,
          "maximum": 96
        },
        "rings": {
          "type": "integer",
          "minimum": 8,
          "maximum": 64
        },
        "brow": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "socket": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "cheek": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "jaw": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "chin": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "temple": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "age": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "description": "Hollowed cheeks and jowls."
        },
        "ears": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "nose": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "length": {
                  "type": "number",
                  "minimum": 0
                },
                "width": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "bridge": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 2
                },
                "hook": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 2
                }
              }
            }
          ]
        },
        "lids": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "description": "Eyelid rims around the socket. Without them an eyeball reads as a ball stuck on a face."
        },
        "eye_radius": {
          "type": "number",
          "minimum": 0,
          "description": "Radius of the eyeball the recipe will place at point:eye_l/eye_r. The lid shells are sized from it."
        }
      }
    },
    "hand_params": {
      "type": "object",
      "additionalProperties": false,
      "description": "Wrist at the origin, fingers along +Z, palm facing -Y.",
      "properties": {
        "length": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "thickness": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "curl": {
          "type": "number",
          "minimum": 0,
          "maximum": 1.5
        },
        "spread": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "thumb": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "side": {
          "enum": [
            "l",
            "r"
          ]
        },
        "segments": {
          "type": "integer",
          "minimum": 6,
          "maximum": 48
        }
      }
    },
    "curve_table": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/vec2"
      },
      "description": "[t, value] pairs, t from 0 at the top to 1 at the bottom."
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "axis"
      ],
      "properties": {
        "axis": {
          "enum": [
            "x",
            "y",
            "z"
          ]
        },
        "min": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "normal_bias": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "direction"
          ],
          "properties": {
            "direction": {
              "$ref": "#/$defs/vec3"
            },
            "min_dot": {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            }
          },
          "description": "Only emit where the surface faces this way. Keeps scalp hair off the face."
        }
      },
      "description": "A normalized span (0..1) along one local axis of the part."
    },
    "sheet_params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "size"
      ],
      "description": "A quad sheet hanging from z=0 to -height, width across X. Give it to the cloth modifier to drape.",
      "properties": {
        "size": {
          "$ref": "#/$defs/vec2",
          "description": "[width, drop] in meters."
        },
        "resolution": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 2,
            "maximum": 80
          },
          "minItems": 2,
          "maxItems": 2
        },
        "shape": {
          "$ref": "#/$defs/curve_table",
          "description": "Width scale down the drop."
        },
        "curve": {
          "$ref": "#/$defs/curve_table",
          "description": "Y offset down the drop, to wrap a body."
        },
        "wrap": {
          "type": "number",
          "description": "Extra Y at the side edges, so it folds round instead of clipping."
        },
        "slack": {
          "type": "number",
          "minimum": 0,
          "description": "Spare fabric for the solver to fold."
        },
        "arc": {
          "type": "number",
          "minimum": 0,
          "maximum": 300,
          "description": "Degrees of wrap around Z before simulating. A cloak starts curved round the shoulders, not flat."
        },
        "gather": {
          "type": "number",
          "minimum": 0,
          "maximum": 1.5,
          "description": "Surplus fabric beyond the span the sheet hangs from, as pleats the solver relaxes into folds. A sheet cut exactly to its arc has nothing to fold into and settles as a smooth shell."
        },
        "folds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 40,
          "description": "How many pleats the gather is distributed into."
        }
      }
    }
  }
}
