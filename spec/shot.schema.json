{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blendy.local/spec/shot.schema.json",
  "title": "Blendy Shot Spec",
  "description": "One shot, described declaratively. The compiler turns this into a Blender scene and nothing else writes to Blender. Independently buildable given the bible.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "meta", "world", "assets", "rigs", "animation", "cameras", "lights", "render"],
  "properties": {
    "version": {
      "description": "Spec format version. Bumped only by a deliberate schema change.",
      "const": "1.1"
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "fps", "frame_start", "frame_end", "seed"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "fps": {"type": "number", "exclusiveMinimum": 0},
        "frame_start": {"type": "integer"},
        "frame_end": {"type": "integer"},
        "seed": {
          "type": "integer",
          "description": "The only source of randomness. No unseeded randomness anywhere in the compiler."
        }
      }
    },
    "world": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hdri", "strength", "background_color"],
      "properties": {
        "hdri": {"oneOf": [{"$ref": "#/$defs/asset_ref"}, {"type": "null"}]},
        "strength": {"type": "number", "minimum": 0},
        "background_color": {"$ref": "#/$defs/rgb"}
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "ref", "transform"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "source": {"enum": ["model", "primitive", "local", "polyhaven"]},
          "ref": {
            "type": "string",
            "minLength": 1,
            "description": "Source-specific identifier: a Poly Haven slug, a Sketchfab uid, a generation prompt, a path, or a primitive name."
          },
          "transform": {"$ref": "#/$defs/transform"},
          "material_overrides": {
            "type": "object",
            "description": "Keyed by material slot name on the imported asset.",
            "additionalProperties": {"$ref": "#/$defs/material"}
          }
        }
      }
    },
    "rigs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "asset_id", "skeleton", "retarget_profile"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "asset_id": {"$ref": "#/$defs/id"},
          "skeleton": {
            "type": "string",
            "minLength": 1,
            "description": "Skeleton type, e.g. 'mixamo'. Profiles are per skeleton, not per character."
          },
          "retarget_profile": {
            "type": "string",
            "minLength": 1,
            "description": "Name of a profile in spec/profiles/<name>.json."
          }
        }
      }
    },
    "animation": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "rig_id", "clip", "frame_start", "blend_in", "blend_out", "loop"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "rig_id": {"$ref": "#/$defs/id"},
          "clip": {"type": "string", "minLength": 1},
          "frame_start": {"type": "integer"},
          "blend_in": {"type": "integer", "minimum": 0},
          "blend_out": {"type": "integer", "minimum": 0},
          "loop": {"type": "boolean"}
        }
      }
    },
    "cameras": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "transform", "focal"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "type": {"enum": ["PERSP", "ORTHO"]},
          "transform": {"$ref": "#/$defs/transform"},
          "focal": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Millimetres for PERSP. Orthographic scale in world units for ORTHO."
          },
          "dof": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["focus_distance", "f_stop"],
                "properties": {
                  "focus_distance": {"type": "number", "exclusiveMinimum": 0},
                  "f_stop": {"type": "number", "exclusiveMinimum": 0},
                  "focus_target": {"oneOf": [{"$ref": "#/$defs/target_ref"}, {"type": "null"}]}
                }
              },
              {"type": "null"}
            ]
          },
          "track_target": {"oneOf": [{"$ref": "#/$defs/target_ref"}, {"type": "null"}]},
          "keyframes": {"$ref": "#/$defs/keyframes"},
          "move": {
            "oneOf": [{"$ref": "#/$defs/camera_move"}, {"type": "null"}],
            "description": "Landmark-anchored move. Mutually exclusive with location keyframes and track_target."
          }
        }
      }
    },
    "lights": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "transform", "energy", "color"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "type": {"enum": ["POINT", "SUN", "SPOT", "AREA"]},
          "transform": {"$ref": "#/$defs/transform"},
          "energy": {
            "type": "number",
            "minimum": 0,
            "description": "Watts, except SUN which is irradiance in W/m^2."
          },
          "color": {"$ref": "#/$defs/rgb"},
          "size": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Shape size. Required for AREA, radius for POINT/SPOT, angular diameter in radians for SUN."
          },
          "spot_size": {"type": "number", "exclusiveMinimum": 0, "maximum": 3.14159265358979},
          "spot_blend": {"type": "number", "minimum": 0, "maximum": 1},
          "track_target": {"oneOf": [{"$ref": "#/$defs/target_ref"}, {"type": "null"}]},
          "keyframes": {"$ref": "#/$defs/keyframes"}
        }
      }
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "samples", "resolution", "output", "camera"],
      "properties": {
        "engine": {
          "enum": ["BLENDER_WORKBENCH", "BLENDER_EEVEE", "CYCLES"],
          "description": "Blender 5.x identifiers. BLENDER_EEVEE_NEXT was 4.2-only and is not valid here."
        },
        "samples": {"type": "integer", "exclusiveMinimum": 0},
        "resolution": {
          "type": "array",
          "items": {"type": "integer", "exclusiveMinimum": 0},
          "minItems": 2,
          "maxItems": 2
        },
        "output": {
          "type": "string",
          "minLength": 1,
          "description": "Directory for frames (final) or a base path (preview). Frames, never movies."
        },
        "camera": {"$ref": "#/$defs/id", "description": "Which camera in cameras[] is the scene camera."},
        "film_transparent": {"type": "boolean"},
        "file_format": {"enum": ["PNG", "OPEN_EXR", "JPEG"]},
        "world_lighting_preset": {
          "type": ["string", "null"],
          "description": "Lighting preset name from profiles/presets/lighting that world+lights were derived from."
        }
      }
    },
    "sequence": {
      "type": "object",
      "additionalProperties": false,
      "description": "Present when this shot belongs to a sequence. Everything here is a reference into the bible or breakdown; the shot may not redefine what it references.",
      "required": ["shot_id", "scene_id", "location", "look", "cast", "enters_with", "exits_with"],
      "properties": {
        "shot_id": {"type": "string", "pattern": "^s[0-9]{2}_[0-9]{3}$"},
        "scene_id": {"type": "string", "pattern": "^s[0-9]{2}$"},
        "location": {"$ref": "#/$defs/id"},
        "look": {"$ref": "#/$defs/id"},
        "cast": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cast_id", "rig_id"],
            "properties": {"cast_id": {"$ref": "#/$defs/id"}, "rig_id": {"$ref": "#/$defs/id"}}
          }
        },
        "dialogue": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["line_id", "cast_id", "frame_start"],
            "properties": {
              "line_id": {"type": "string", "minLength": 1},
              "cast_id": {"$ref": "#/$defs/id"},
              "frame_start": {"type": "integer"}
            }
          }
        },
        "enters_with": {"$ref": "#/$defs/continuity_state"},
        "exits_with": {"$ref": "#/$defs/continuity_state"}
      }
    },
    "audio": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "frame_start"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "path": {"type": "string", "minLength": 1},
          "frame_start": {"type": "integer"},
          "volume": {"type": "number", "minimum": 0}
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "minLength": 1,
      "maxLength": 64,
      "description": "Stable identifier. Lowercase snake_case. Unique across the whole spec; all references are by id, never by index."
    },
    "vec3": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
    "rgb": {
      "type": "array",
      "items": {"type": "number", "minimum": 0},
      "minItems": 3,
      "maxItems": 3,
      "description": "Linear RGB. Values above 1 are allowed for emissive intent."
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["location", "rotation_euler", "scale"],
      "description": "Blender world units, Z-up, XYZ euler in radians. Always fully specified; no implicit defaults.",
      "properties": {
        "location": {"$ref": "#/$defs/position"},
        "rotation_euler": {"$ref": "#/$defs/vec3"},
        "scale": {"$ref": "#/$defs/vec3"},
        "anchor": {
          "oneOf": [{"$ref": "#/$defs/landmark_ref"}, {"type": "null"}],
          "description": "If set, location is an offset from this landmark instead of world space, and the object follows it (parented to the bone for rigged characters)."
        },
        "anchor_offset": {"$ref": "#/$defs/vec3"}
      }
    },
    "asset_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "ref"],
      "properties": {
        "source": {"enum": ["model", "primitive", "local", "polyhaven"]},
        "ref": {"type": "string", "minLength": 1}
      }
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "base_color": {"$ref": "#/$defs/rgb"},
        "metallic": {"type": "number", "minimum": 0, "maximum": 1},
        "roughness": {"type": "number", "minimum": 0, "maximum": 1},
        "emission": {"$ref": "#/$defs/rgb"},
        "emission_strength": {"type": "number", "minimum": 0}
      }
    },
    "keyframes": {
      "type": "array",
      "description": "Explicit f-curves. Legal for cameras and lights only; character performance is retargeted, never keyframed.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["channel", "frame", "value", "interpolation"],
        "properties": {
          "channel": {
            "enum": [
              "location",
              "rotation_euler",
              "scale",
              "focal",
              "dof.focus_distance",
              "dof.f_stop",
              "energy",
              "color"
            ]
          },
          "frame": {"type": "integer"},
          "value": {"oneOf": [{"type": "number"}, {"$ref": "#/$defs/vec3"}]},
          "interpolation": {"enum": ["CONSTANT", "LINEAR", "BEZIER"]}
        }
      }
    },
    "landmark_ref": {
      "type": "string",
      "pattern": "^@[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$",
      "description": "\"@<asset_id>.<landmark>\", resolved at compile time against the asset profile. Validation rejects unknown landmarks and lists the ones that exist."
    },
    "target_ref": {
      "oneOf": [{"$ref": "#/$defs/id"}, {"$ref": "#/$defs/landmark_ref"}],
      "description": "An entity id (object origin) or a landmark reference."
    },
    "position": {
      "oneOf": [{"$ref": "#/$defs/vec3"}, {"$ref": "#/$defs/landmark_ref"}],
      "description": "World-space vec3, or a landmark reference resolved at compile time."
    },
    "camera_move": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keys"],
      "description": "A camera move stored relative to landmarks. Position is derived at compile time from target + spherical offset, so the move survives re-blocking and recasting.",
      "properties": {
        "preset": {"type": ["string", "null"], "description": "Name of the preset this came from, if any."},
        "keys": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["frame", "target", "distance", "azimuth", "elevation", "focal", "interpolation"],
            "properties": {
              "frame": {"type": "integer"},
              "target": {
                "oneOf": [{"$ref": "#/$defs/target_ref"}, {"$ref": "#/$defs/vec3"}],
                "description": "Landmark or entity id. A raw vec3 is an unsnapped key: allowed, but flagged."
              },
              "distance": {"type": "number", "exclusiveMinimum": 0},
              "azimuth": {
                "type": "number",
                "description": "Degrees around Z, 0 = +Y (in front of target), 90 = +X."
              },
              "elevation": {
                "type": "number",
                "minimum": -90,
                "maximum": 90,
                "description": "Degrees above the target plane."
              },
              "roll": {"type": "number", "description": "Degrees, camera roll about its view axis."},
              "focal": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "mm; must be in the bible lens_set for sequence shots."
              },
              "interpolation": {"enum": ["CONSTANT", "LINEAR", "BEZIER"]},
              "ease": {"enum": ["AUTO", "AUTO_CLAMPED", "VECTOR", "FREE"]}
            }
          }
        }
      }
    },
    "continuity_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["positions", "props", "world"],
      "properties": {
        "positions": {
          "type": "object",
          "additionalProperties": {"type": "string", "minLength": 1},
          "description": "cast_id -> landmark-anchored position or named blocking mark."
        },
        "props": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "held_by": {"type": "string"},
              "hand": {"enum": ["L", "R"]},
              "placed_at": {"type": "string"}
            }
          }
        },
        "world": {"type": "object", "additionalProperties": {"type": ["boolean", "string", "number"]}},
        "emotional": {"type": ["string", "null"]}
      }
    }
  }
}
